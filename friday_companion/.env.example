# FRIDAY Android Companion — Environment Configuration
# Copy to .env or pass via --dart-define for builds

# Default laptop server URL (10.0.2.2 maps to host localhost on Android Emulator)
FRIDAY_BASE_URL=http://10.0.2.2:3141

# Environment: development | production
FRIDAY_ENV=development

# Request timeout in milliseconds
FRIDAY_REQUEST_TIMEOUT_MS=10000
