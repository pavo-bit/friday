# ============================================================
# FRIDAY Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- OpenRouter AI Provider ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=FRIDAY
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_RETRIES=2

# --- Server ---
FRIDAY_PORT=3141
FRIDAY_HOST=127.0.0.1

# --- Claw Binary Path (auto-detected if not set) ---
# CLAW_BINARY_PATH=../rust/target/debug/claw.exe

# --- Safety ---
# Max actions per minute (all risk levels)
RATE_LIMIT_PER_MINUTE=30
# Max high-risk actions per hour
HIGH_RISK_LIMIT_PER_HOUR=5
# Require approval for high-risk actions (true/false)
REQUIRE_HIGH_RISK_APPROVAL=true

# --- Voice ---
# Voice input/output are provided by browser speech APIs in the dashboard.
# No paid API key is required. Browser speech recognition may use online browser services.
STT_ENGINE=none
TTS_ENGINE=none
# Wake word (say this to activate listening)
WAKE_WORD=friday

# --- Memory ---
# SQLite database path
FRIDAY_DB_PATH=./data/friday.db

# --- Control Layer ---
# Allowed directories for file operations (comma-separated)
ALLOWED_DIRECTORIES=.
# Enable browser automation
ENABLE_BROWSER_CONTROL=true
# Enable PC automation (pyautogui)
ENABLE_PC_CONTROL=false

# --- Email (Communication Department) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=you@example.com
EMAIL_PASS=app_specific_password_here
EMAIL_FROM=you@example.com
